LLM_PROVIDER=groq
LLM_API_KEY=your_key_here
# llama-3.3-70b-versatile was deprecated by Groq on 2026-08-16 (404s with
# model_not_found now). openai/gpt-oss-20b is Groq's current free-tier
# model and is what llm_client.py already falls back to by default even
# with no LLM_MODEL set -- kept explicit here so it's obvious which model
# actually runs.
LLM_MODEL=openai/gpt-oss-20b
